---
import PageLayout from '../../layouts/PageLayout.astro';
import {getPosts, toMeta} from '../../lib/posts';

const posts = (await getPosts()).map(toMeta);
---
<PageLayout title="posts" description="Posts by Mustapha Charboub." path="/posts/" sub="ls posts/">
    <div class="inner">
        <p class="crumb"><span class="sym">$</span> ls posts/</p>
        <p class="out">total {posts.length}</p>
        {posts.length === 0 ? (
                <p class="faint">nothing published yet — the first post is being written<span
                        class="dots"><span>.</span><span>.</span><span>.</span></span></p>
        ) : (
                <ul class="index-list">
                    {posts.map((p) => (
                            <li>
                                <a class="t" href={p.url}>{p.title}</a>
                                <span class="meta"> · {p.date} · {p.readingTime}</span>
                                {p.description && <p class="desc">{p.description}</p>}
                            </li>
                    ))}
                </ul>
        )}
    </div>
</PageLayout>
