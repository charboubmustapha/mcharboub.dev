---
import {render} from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import type {InferGetStaticPropsType} from 'astro';
import {getPosts, postPaths, toMeta} from '../../lib/posts';

export const getStaticPaths = postPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const {post} = Astro.props as Props;
const meta = toMeta(post);
const {Content} = await render(post);
const all = (await getPosts()).map(toMeta);
const idx = all.findIndex((p) => p.slug === meta.slug);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
---
<PageLayout title={meta.title} description={meta.description || meta.title} path={meta.url} type="article"
            sub={`cat posts/${meta.slug}`}>
    <article class="inner article">
        <p class="crumb"><a href="/posts/">posts/</a> / {meta.slug}</p>
        <h1 class="title">{meta.title}</h1>
        <p class="meta">
            <time datetime={meta.date}>{meta.date}</time>
            · {meta.readingTime}</p>
        <div class="body">
            <Content/>
        </div>
        {(newer || older) && (
                <nav class="postnav" aria-label="Other posts">
                    {newer && <a class="newer" href={newer.url}>← {newer.title}</a>}
                    {older && <a class="older" href={older.url}>{older.title} →</a>}
                </nav>
        )}
    </article>
</PageLayout>
