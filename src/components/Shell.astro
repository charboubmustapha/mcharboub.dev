---
import { getImage } from 'astro:assets';
import PageHeader from './PageHeader.astro';
import PageFooter from './PageFooter.astro';
import me from '../assets/me.png';

const portrait = await getImage({ src: me, width: 768, format: 'webp' });
const photo = await getImage({ src: me, width: 1024, format: 'webp' });
const dims = `${me.width}×${me.height}`;

const about = {
  kicker: 'lead software engineer',
  hi: 'Hi,',
  name: "I'm Mustapha.",
  lede: ["I've written Java for a living since 2015.", "Here I write about what I've learned and what I'm passionate about."],
};
const mail = 'charboubmustapha@pm.me';
const links = [
  { label: 'github', href: 'https://github.com/charboubmustapha', delay: '.18s' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/mustapha-charboub-878751246', delay: '.3s' },
];

interface Command {
  name: string;
  run?: string;
  desc: string;
  footer?: boolean;
}
const commands: Command[] = [
  { name: 'about', run: 'cat about.md', desc: 'who I am', footer: true },
  { name: 'posts', run: 'ls posts/', desc: "what I've written", footer: true },
  { name: 'contact', run: 'open contact', desc: 'how to reach me', footer: true },
  { name: 'me', run: 'me', desc: 'the portrait, as text' },
  { name: 'clear', run: 'clear', desc: 'clear the screen' },
  { name: 'theme dark|light', desc: 'switch the theme' },
];
const footerButtons = [...commands.filter((c) => c.footer), { name: 'help', run: 'help' }];
const delay = (i: number) => (i ? `--d:${String(+(i * 0.08).toFixed(2)).replace(/^0/, '')}s` : undefined);
---
<div class="shell" id="shell" data-portrait={portrait.src}>
  <PageHeader sub="bash" />

  <div class="scroll" id="scroll">
    <div class="screen" id="screen">
      <noscript>
        <div class="entry">
          <p class="cmdline"><span class="sym">$</span> cat about.md</p>
          <div class="block">
            <p class="kicker">{about.kicker}</p>
            <h1 class="greeting">{about.hi}<br />{about.name}</h1>
            <p class="lede">{about.lede[0]}</p>
            <p class="lede">{about.lede[1]} Posts: <a href="/posts/">/posts/</a>.</p>
          </div>
        </div>
        <div class="entry">
          <p class="cmdline"><span class="sym">$</span> open contact</p>
          <div class="block">
            <a class="mail" href={`mailto:${mail}`}>{mail}</a>
            <div class="links">
              {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
            </div>
          </div>
        </div>
        <p class="faint">This shell needs JavaScript. The posts are readable without it at <a href="/posts/">/posts/</a>.</p>
      </noscript>
      <div class="boot" id="boot" aria-hidden="true"></div>
      <div id="entries" aria-live="polite" aria-relevant="additions"></div>

      <form class="promptrow" id="promptrow" autocomplete="off">
        <span class="sym" aria-hidden="true">$</span>
        <div class="field">
          <span class="ghost" aria-hidden="true"><span class="mirror" id="mirror"></span><span id="ghost"></span><span class="caret" aria-hidden="true"></span></span>
          <input class="cmd-input" id="cmd" type="text" name="cmd" aria-label="Command" aria-describedby="ghost-hint" spellcheck="false" autocomplete="off" autocapitalize="off"
                 enterkeyhint="go" />
        </div>
      </form>
      <p class="ghost-hint" id="ghost-hint" hidden></p>
    </div>
  </div>

  <PageFooter>
    {footerButtons.map((c) => (
      <button type="button" class="cmdbtn" data-run={c.run}>{c.name}<span class="real" aria-hidden="true">{c.run}</span></button>
    ))}
    <span class="hover-hint" id="hover-hint" aria-hidden="true">→ <span id="hover-cmd"></span></span>
  </PageFooter>

  <template id="tpl-about">
    <div class="block about">
      <figure class="portrait appear-slow" style="--d:.2s" role="img" aria-label="ASCII portrait of Mustapha">
        <pre class="ascii small" data-ascii="small" aria-hidden="true"></pre>
        <figcaption>me.png · rendered as text</figcaption>
      </figure>
      <div class="about-text">
        <p class="kicker appear">{about.kicker}</p>
        <h1 class="greeting appear" style="--d:.14s"><span class="greet"><span class="greet-word">{about.hi}</span><span class="greet-caret"></span></span><br />{about.name}</h1>
        <p class="lede appear" style="--d:.3s">{about.lede[0]}</p>
        <p class="lede appear" style="--d:.44s">{about.lede[1]}</p>
      </div>
    </div>
  </template>

  <template id="tpl-img">
    <figure class="portrait-large appear-slow" role="img" aria-label="ASCII portrait of Mustapha">
      <pre class="ascii large" data-ascii="large" aria-hidden="true"></pre>
      <figcaption>me.png — {dims} · 110 cols · try "open me.png" for the original</figcaption>
    </figure>
  </template>

  <template id="tpl-photo">
    <figure class="photo appear-slow">
      <img src={photo.src} alt="Mustapha" width={photo.attributes.width} height={photo.attributes.height} />
      <figcaption>me.png — {photo.attributes.width}×{photo.attributes.height}</figcaption>
    </figure>
  </template>

  <template id="tpl-posts-empty">
    <div class="appear">
      <p class="out">total 0</p>
      <p class="faint">nothing published yet — the first post is being written<span class="dots"><span>.</span><span>.</span><span>.</span></span></p>
    </div>
  </template>

  <template id="tpl-contact">
    <div class="block">
      <a class="mail appear" href={`mailto:${mail}`}>{mail}</a>
      <div class="links">
        {links.map((l) => <a class="appear" style={`--d:${l.delay}`} href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
      </div>
    </div>
  </template>

  <template id="tpl-help">
    <div class="help">
      {commands.map((c, i) => (
        <>
          {c.run
            ? <button type="button" class="name appear-fast" style={delay(i)} data-run={c.run}>{c.name}</button>
            : <span class="name appear-fast" style={delay(i)}>{c.name}</span>}
          <span class="desc appear-fast" style={delay(i)}>{c.desc}</span>
        </>
      ))}
    </div>
    <p class="tips appear-fast" style="--d:.5s">tab completes · ↑ ↓ browse history · ls shows the files</p>
  </template>

  <template id="tpl-ls">
    <p class="ls appear">about.md  contact.txt  lessons.log  me.png  <span class="dir">posts/</span></p>
  </template>
</div>

<script>
  import { initShell } from '../scripts/shell.js';
  initShell(document.getElementById('shell')!);
</script>
