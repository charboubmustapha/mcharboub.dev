---
import {TOGGLE_LABEL} from '../lib/theme';
---
<button type="button" class="theme" data-theme-toggle aria-label={TOGGLE_LABEL.dark} title={TOGGLE_LABEL.dark}>
    <svg class="ico-sun" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linecap="round" aria-hidden="true">
        <circle cx="8" cy="8" r="3.2"></circle>
        <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M13 3l-1.4 1.4M4.4 11.6L3 13"></path>
    </svg>
    <svg class="ico-moon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linejoin="round" aria-hidden="true">
        <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z"></path>
    </svg>
</button>
